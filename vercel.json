{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/Main.html"
    },
    {
      "source": "/play",
      "destination": "/GameLobby.html"
    },
    {
      "source": "/profile",
      "destination": "/Profile.html"
    },
    {
      "source": "/admin/suggestions",
      "destination": "/SuggestionsAdmin.html"
    },
    {
      "source": "/arcade/ability-draft",
      "destination": "/AbilityDraft.html"
    },
    {
      "source": "/arcade/leader-protocol",
      "destination": "/LeaderProtocol.html"
    },
    {
      "source": "/arcade/crownfall",
      "destination": "/HeroChess.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
