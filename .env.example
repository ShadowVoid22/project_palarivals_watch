# New Vercel Blob connections use these OIDC values automatically.
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=

# Older Blob connections use this read/write token instead.
BLOB_READ_WRITE_TOKEN=

# Choose a long random value. Use it as a Bearer token to download suggestions through GET /api/suggestions.
SUGGESTIONS_ADMIN_KEY=

# SQL Server account database used by /api/auth.
# The Users.Password column must support at least 255 characters so passwords can be stored as hashes.
# Use a long random value to sign account sessions used by profile tracking.
AUTH_SESSION_SECRET=
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_DATABASE=
DB_PORT=1433
